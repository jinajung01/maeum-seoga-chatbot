rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // 관리자 여부: Firebase 콘솔에서 admin_allowlist 컬렉션에
    // "문서 ID = 관리자 Google 이메일"인 문서를 만들어 등록한다 (이메일은 저장소에 두지 않음)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_allowlist/$(request.auth.token.email));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin profiles
    match /admins/{adminUid} {
      allow read: if isOwner(adminUid);
      allow create, update: if isOwner(adminUid);
      allow delete: if false;
    }

    // 관리자 목록: 콘솔에서만 관리 (사이트에서는 읽기·쓰기 불가)
    match /admin_allowlist/{email} {
      allow read, write: if false;
    }

    // AI configurations: 누구나 읽기(추천 권수 반영), 저장은 등록된 관리자만
    match /ai_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
